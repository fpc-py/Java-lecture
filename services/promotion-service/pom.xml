<?xml version="1.0" encoding="UTF-8"?>
<!-- 促销服务：被刻意做成"慢依赖"——它是 ch11 雪崩与 ch17 熔断演练的原材料 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.polaris.trade</groupId>
        <artifactId>polaris-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>polaris-promotion-service</artifactId>
    <name>Polaris Promotion Service</name>

    <dependencies>
        <dependency>
            <groupId>com.polaris.trade</groupId>
            <artifactId>polaris-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.polaris.trade</groupId>
            <artifactId>polaris-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.polaris.trade</groupId>
            <artifactId>polaris-starter-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.polaris.trade</groupId>
            <artifactId>polaris-starter-guard</artifactId>
        </dependency>
        <dependency>
            <groupId>com.polaris.trade</groupId>
            <artifactId>polaris-starter-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.polaris.trade</groupId>
            <artifactId>polaris-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.polaris.trade</groupId>
            <artifactId>polaris-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                    <mainClass>com.polaris.trade.promotion.PromotionServiceApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
