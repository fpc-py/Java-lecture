{
  "uid": "polaris-jvm",
  "title": "Polaris · JVM 与线程池",
  "tags": [
    "polaris",
    "jvm",
    "ch02",
    "ch03"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "① 内存版图：堆内 / 堆外必须分开看",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "堆使用率",
      "description": "只看堆会得出错误结论。ch02 场景 A 里 heap 常年 40%，进程照样被 OOMKilled。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"}) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "进程 RSS",
      "description": "RSS 才是被 cgroup/k8s limit 约束的那个数。它与堆的差额就是堆外。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "堆外占比",
      "description": "超过 50% 说明堆外吃得比堆还多 —— 这时候再怎么调 -Xmx 都没用。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "(process_resident_memory_bytes - sum(jvm_memory_used_bytes{area=\"heap\"})) / process_resident_memory_bytes * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "GC 暂停速率",
      "description": "每秒花在 GC 上多少秒。>0.05 即 5% 的吞吐被 GC 吃掉。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.15
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "堆内存（used / committed / max）",
      "description": "used 反复贴顶 + committed 等于 max = 堆真的不够了；used 有锯齿但 committed 平稳 = 正常的新生代回收。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_memory_committed_bytes{area=\"heap\"})",
          "legendFormat": "committed",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "max",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "非堆（Metaspace / Code Cache / Direct）",
      "description": "Metaspace 单调上升 = 类加载泄漏（动态代理反复生成类）。Direct 上升不降 = ByteBuf 未 release。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\",id=\"Metaspace\"})",
          "legendFormat": "Metaspace",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\",id=\"CodeHeap 'non-nmethods'\"})",
          "legendFormat": "CodeHeap non-nmethods",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\",id=\"CodeHeap 'profiled nmethods'\"})",
          "legendFormat": "CodeHeap profiled",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_buffer_memory_used_bytes{id=\"direct\"})",
          "legendFormat": "Direct Buffer",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum(jvm_buffer_memory_used_bytes{id=\"mapped\"})",
          "legendFormat": "Mapped Buffer",
          "refId": "E"
        }
      ]
    },
    {
      "type": "row",
      "title": "② GC：次数、耗时、单次停顿时长",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GC 次数速率（按 action）",
      "description": "只看总次数会漏掉 Full GC：YGC 100 次/分是正常的，FGC 1 次/分就是事故。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum by (action) (rate(jvm_gc_pause_seconds_count[1m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC 单次停顿（平均 / 最大）",
      "description": "平均停顿保证有数；最大停顿依赖 registry 是否导出 _max。P99 抖动的第一嫌疑人：超过 200ms 且与 RT 抖动时间点重合，基本可以定案。",
      "datasource": {
        "type": "prometheus",
        "uid": "polaris-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "sum by (action) (rate(jvm_gc_pause_seconds_sum[1m])) / clamp_min(sum by (action) (rate(jvm_gc_pause_seconds_count[1m])), 0.001)",
          "legendFormat": "平均 {{action}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "polaris-prom"
          },
          "expr": "max by (action) (jvm_gc_pause_seconds_max[1m])",
          "legendFormat": "最大 {{action}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "③ 线程：数量、状态、各池占用",
